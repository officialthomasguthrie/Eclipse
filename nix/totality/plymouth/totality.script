# the boot progress is an eclipse: a black disc slides over a light one until a thin ring is left.
# neutral dark gray background, nothing else. pngs come from tools/gen-totality-assets.py, drawn large
# and scaled here to a fifth of the screen height so the same theme fits every mode.

Window.SetBackgroundTopColor(0.118, 0.118, 0.118);
Window.SetBackgroundBottomColor(0.118, 0.118, 0.118);

cx = Window.GetWidth() / 2;
cy = Window.GetHeight() / 2;
size = Math.Int(Window.GetHeight() / 5);

sun.image = Image("sun.png").Scale(size, size);
moon.image = Image("moon.png").Scale(size, size);
dot.image = Image("dot.png").Scale(Math.Int(size / 16), Math.Int(size / 16));

sun.sprite = Sprite(sun.image);
sun.sprite.SetPosition(cx - size / 2, cy - size / 2, 1);

moon.sprite = Sprite(moon.image);

# the moon starts a little right of centre, so a crescent of the sun shows, and slides to totality
travel = size * 0.3;

fun place_moon(p) {
  moon.sprite.SetPosition(cx - size / 2 + travel * (1 - p), cy - size / 2, 2);
}

place_moon(0);

fun boot_progress_cb(duration, p) {
  place_moon(p);
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

# the passphrase prompt under the sun: the question and one dot per character. systemd-cryptsetup
# asks in words of its own, which read here as a plain request. a new drive asks its own questions
prompt.sprite = Sprite();
dot.step = Math.Int(size / 8);

fun prompt_label(text) {
  if (!text)
    return "Enter your passphrase";
  if (text.SubString(0, 12) == "Please enter")
    return "Enter your passphrase";
  return text;
}

fun display_password_cb(prompt_text, bullet_count) {
  label = Image.Text(prompt_label(prompt_text), 0.8, 0.8, 0.8, 1, "Sans 11");
  prompt.sprite.SetImage(label);
  prompt.sprite.SetPosition(cx - label.GetWidth() / 2, cy + size * 0.85, 5);
  prompt.sprite.SetOpacity(1);
  left = cx - (bullet_count - 1) * dot.step / 2 - dot.image.GetWidth() / 2;
  top = cy + size * 0.85 + label.GetHeight() + dot.step;
  for (i = 0; dots[i] || i < bullet_count; i++) {
    if (!dots[i])
      dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetPosition(left + i * dot.step, top, 5);
    if (i < bullet_count)
      dots[i].sprite.SetOpacity(1);
    else
      dots[i].sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
  prompt.sprite.SetOpacity(0);
  for (i = 0; dots[i]; i++)
    dots[i].sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

fun quit_cb() {
  place_moon(1);
}
Plymouth.SetQuitFunction(quit_cb);
